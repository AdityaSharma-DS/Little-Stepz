# ls-postgres from docker/website-postgres.compose.yml. Prisma reads this file for the CLI and the
# running backend; if apps/backend/.env also sets DATABASE_URL, that one wins at runtime, so keep them equal.
DATABASE_URL="postgresql://littlestepz:<LS_DB_PASSWORD>@127.0.0.1:5432/littlestepz?schema=public&connection_limit=10"
